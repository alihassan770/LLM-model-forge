 "definitions": {
  "ContainerTaskConfiguration": {
   "additionalProperties": false,
   "description": "Configuration for running a custom container image on managed compute.",
   "properties": {
    "Command": {
     "description": "The command to execute in the container.",
     "insertionOrder": true,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "EcrUri": {
     "description": "The Amazon ECR image URI for the task container.",
     "maxLength": 1024,
     "minLength": 1,
     "pattern": "^((\\d{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.[a-z.]+)|public\\.ecr\\.aws/[a-z][a-z0-9]+([._-][a-z0-9]+)*)/[a-z0-9]+((\\.||__|__|-+)[a-z0-9]+)*(/[a-z0-9]+((\\.||__|__|-+)[a-z0-9]+)*)*(:[a-zA-Z0-9._-]+|@sha256:[a-f0-9]{64})?$",
     "type": "string"
    },
    "EnvironmentVariables": {
     "$ref": "#/definitions/EnvironmentVariablesMap"
    },
    "ProcessingType": {
     "description": "The processing type for compute resources.",
     "enum": [
      "GENERIC_COMPUTE_PROCESSING",
      "HARDWARE_ACCELERATED_PROCESSING"
     ],
     "type": "string"
    },
    "ProcessingUnit": {
     "description": "The processing unit allocation that determines vCPU, memory, and GPU resources.",
     "enum": [
      "UNITS_2",
      "UNITS_4",
      "UNITS_8",
      "UNITS_12",
      "UNITS_16",
      "UNITS_24",
      "UNITS_32",
      "UNITS_36",
      "UNITS_48",
      "UNITS_60",
      "UNITS_64",
      "UNITS_72",
      "UNITS_84",
      "UNITS_96"
     ],
     "type": "string"
    },
    "TaskExecutionRole": {
     "description": "The ARN of the IAM role that grants the containerized workload permissions to access AWS resources.",
     "maxLength": 2048,
     "minLength": 20,
     "pattern": "^arn:[\\w+=\\/,.@-]+:iam::[0-9]+:role/[\\w+=,.@/-]+$",
     "type": "string"
    },
    "TimeoutSeconds": {
     "description": "The timeout in seconds for task execution. Default: 3600 (1 hour).",
     "maximum": 86400,
     "minimum": 60,
     "type": "integer"
    }
   },
   "required": [
    "EcrUri",
    "TaskExecutionRole",
    "ProcessingType",
    "ProcessingUnit"
   ],
   "type": "object"
  },
  "EnvironmentVariablesMap": {
   "additionalProperties": false,
   "description": "A map of environment variable key-value pairs.",
   "maxProperties": 100,
   "patternProperties": {
    "^[a-zA-Z_][a-zA-Z0-9_]*$": {
     "maxLength": 2048,
     "type": "string"
    }
   },
   "type": "object"
  },
  "Tag": {
   "additionalProperties": false,
